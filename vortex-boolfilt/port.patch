+
+/// Whether [`filter_bitbuffer_by_mask`] compresses words in hardware: BMI2 PEXT where it is fast,
+/// or SVE2 BEXT.
+fn hardware_pext() -> bool {
+    static HARDWARE: OnceLock<bool> = OnceLock::new();
+    *HARDWARE.get_or_init(|| {
+        #[cfg(target_arch = "x86_64")]
+        {
+            return has_fast_pext();
+        }
+        #[cfg(target_arch = "aarch64")]
+        {
+            return std::arch::is_aarch64_feature_detected!("sve2-bitperm");
+        }
+        #[allow(unreachable_code)]
+        false
+    })
+}
 
