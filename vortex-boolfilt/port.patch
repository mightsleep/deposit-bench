+fn compress_bytes(src: u64, mask: u64) -> u64 {
+    let mut packed = src & mask;
+    let mut dropped = !mask;
+    let mut shift = 1;
+    while shift < 8 {
+        // The bits that move down by `shift` this round: the parity of the dropped bits below
+        // each bit, in strides of `shift`.
+        let mut moves = dropped;
+        let mut step = shift;
+        while step < 8 {
+            moves ^= (moves << step) & repeat_byte(0xFF << step);
+            step <<= 1;
+        }
+        let moving = packed & moves;
+        packed ^= moving ^ ((moving >> shift) & repeat_byte(0xFF >> shift));
+        dropped &= !moves;
+        dropped ^= (dropped >> shift) & repeat_byte(0xFF >> shift);
+        shift <<= 1;
+    }
+    // Kept bits per byte (Hacker's Delight 5-1), then their sums over the bytes below.
+    let pairs = mask - ((mask >> 1) & repeat_byte(0x55));
+    let nibbles = (pairs & repeat_byte(0x33)) + ((pairs >> 2) & repeat_byte(0x33));
