+/// BMI2 is there and its PEXT runs in hardware. Zen 1 and 2 (AMD family 17h, and Hygon's
+/// Zen-based family 18h) implement it in microcode, tens to hundreds of cycles depending on the
+/// mask, slower than [`pext_fallback`].
+#[cfg(target_arch = "x86_64")]
+fn has_fast_pext() -> bool {
+    use std::arch::x86_64::__cpuid;
+
+    if !std::arch::is_x86_feature_detected!("bmi2") {
+        return false;
+    }
+    let vendor = __cpuid(0);
+    let leaf1 = __cpuid(1).eax;
+    let base_family = (leaf1 >> 8) & 0xF;
+    let family = if base_family == 0xF {
+        base_family + ((leaf1 >> 20) & 0xFF)
+    } else {
+        base_family
+    };
+    // "AuthenticAMD" and "HygonGenuine", as cpuid spells them in ebx, edx, ecx
+    let amd = (vendor.ebx, vendor.edx, vendor.ecx) == (0x6874_7541, 0x6974_6E65, 0x444D_4163);
+    let hygon = (vendor.ebx, vendor.edx, vendor.ecx) == (0x6F67_7948, 0x6E65_476E, 0x656E_6975);
+    !(amd && family == 0x17 || hygon && family == 0x18)
+}
