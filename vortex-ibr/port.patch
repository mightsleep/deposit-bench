+    fn deposit_reference(mut source: u64, mut mask: u64) -> u64 {
+        let mut result = 0u64;
+        while mask != 0 {
+            let bit = mask & mask.wrapping_neg();
+            if source & 1 != 0 {
+                result |= bit;
+            }
+            source >>= 1;
+            mask &= mask - 1;
+        }
